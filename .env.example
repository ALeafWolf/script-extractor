# Vision extractor (screenshot → blocks)
OPENAI_API_KEY=sk-...
VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
VISION_MAX_IMAGE_WIDTH=1600

# Ingestor / Postgres (+ pgvector)
DATABASE_URL=postgres://user:pass@localhost:5432/zuoran

# Unit embeddings (story_units.embedding)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Scene / episode / chapter summaries + structured facts (post-ingest & backfill)
# `npm run dev` loads this file automatically; `npm run backfill:summaries` loads it too (see scripts/backfillSummaries.ts).
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_MAX_INPUT_CHARS_SCENE=24000
SUMMARY_TIMEOUT_MS=120000

# Set to 1 to disable automatic summaries & facts after ingest (data still saves)
# SKIP_AUTO_SUMMARY=1
